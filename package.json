{
	"name": "agent-deck",
	"version": "0.3.0",
	"private": true,
	"description": "Stream Deck plugin: one key per Claude Code / Codex session, showing live state and jumping to its window.",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.hbyi.agentdeck\"",
		"link": "streamdeck link com.hbyi.agentdeck.sdPlugin",
		"validate": "streamdeck validate com.hbyi.agentdeck.sdPlugin",
		"pack": "streamdeck pack com.hbyi.agentdeck.sdPlugin",
		"simulate": "node tools/simulate.mjs",
		"test": "node --import tsx --test \"tests/**/*.test.ts\""
	},
	"type": "module",
	"devDependencies": {
		"@elgato/cli": "^1.10.4",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^15.2.2",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~24.1.0",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"tsx": "^4.23.15",
		"typescript": "^5.2.2"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.4"
	}
}
